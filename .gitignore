###########################################################################################
# .gitignore 文件用于指定 Git 忽略的文件和文件夹，以避免它们被提交到版本控制系统中。
# 在 .gitignore 文件中，你可以使用以下语法来定义需要忽略的文件和文件夹：
# # 1. 过滤整个文件夹（最常用）
# node_modules/      # 忽略 node_modules 文件夹及其所有内容
# build/             # 忽略 build 文件夹
# dist/              # 忽略 dist 文件夹
# .idea/             # 忽略 IDE 配置文件
# .vscode/           # 忽略 VSCode 配置文件

# # 2. 过滤特定后缀的大文件
# *.zip              # 忽略所有 zip 压缩包
# *.tar.gz           # 忽略所有 tar.gz 压缩包
# *.log              # 忽略所有日志文件
# *.mp4              # 忽略所有视频文件
# *.psd              # 忽略所有 Photoshop 源文件

# # 3. 过滤特定的某个大文件
# large_dataset.csv  # 忽略根目录下的这个特定文件
# models/weight.bin  # 忽略特定路径下的文件

# # 4. 其他高级语法
# *.tmp              # 忽略所有 .tmp 结尾的文件
# !important.tmp     # 但是不忽略 important.tmp（取反）
# /logs/             # 只忽略根目录下的 logs 文件夹，不忽略子目录下的（如 src/logs/）

#########################################################################################

# 过滤掉model与workspace目录下的内容
model/
workspace/
GUI\.pnpm-store
GUI\.npm-cache